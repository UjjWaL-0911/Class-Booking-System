# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# For the skeleton (component 1) the database URLs only need to be well-formed —
# nothing connects yet, so the placeholders below are enough to boot the app.
# Replace them with real Supabase values when the database layer lands.

# ---------------------------------------------------------------- app
ENVIRONMENT=local
LOG_LEVEL=INFO

# ----------------------------------------------------------- database
# Application connection: Supabase TRANSACTION pooler (port 6543).
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/class_booking

# Alembic only: Supabase SESSION pooler (port 5432), owner role.
# DDL and transaction pooling do not mix, so migrations never use DATABASE_URL.
# Note: the *direct* endpoint (db.<ref>.supabase.co) is IPv6-only and unreachable
# from Render, which is why this is the session pooler and not the direct host.
MIGRATION_DATABASE_URL=postgresql://postgres:password@localhost:5432/class_booking


# --------------------------------------------------------------- auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string

# ----------------------------------------------------------- business
# REQUIRED, no default. Four goals produce wrong numbers if this is wrong:
# "sessions today", "no-shows this week", the 7-day alert window, and the
# "has this session started" settlement gate.
STUDIO_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------ observability
# SENTRY_DSN=

# --------------------------------------------- optional overrides
# Defaults are in app/core/config.py and are correct for the free tier.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# TRUSTED_PROXY_HOPS=1
